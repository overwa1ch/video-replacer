# Developer/operator field contract. The repository does not auto-load env
# files. First-run Agents must not tell downloaders to copy or edit this file;
# API secrets enter through a protected OS/session secret mechanism instead.

# Optional binary/runtime overrides
CODEX_BINARY=/absolute/path/to/codex
DREAMINA_BINARY=/absolute/path/to/dreamina
FFMPEG=/absolute/path/to/ffmpeg
VIDEO_REPLACER_STATE_DIR=/absolute/path/outside/the/repository

# Optional Ark Seedance 2.5 profile
VIDEO_REPLACER_ARK_API_KEY=<replace-with-ark-api-key>
# Fixed official Ark base; overrides are rejected unless they resolve to this host/path.
VIDEO_REPLACER_ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_REPLACER_ARK_SEEDANCE_2_5_MODEL_ID=<replace-with-account-model-id>
VIDEO_REPLACER_TOS_ACCESS_KEY=<replace-with-tos-access-key>
VIDEO_REPLACER_TOS_SECRET_KEY=<replace-with-tos-secret-key>
# Optional temporary credential; leave unset for long-lived credentials.
VIDEO_REPLACER_TOS_SECURITY_TOKEN=<replace-with-temporary-security-token>
VIDEO_REPLACER_TOS_ENDPOINT=<replace-with-official-volces-tos-endpoint>
VIDEO_REPLACER_TOS_REGION=<replace-with-tos-region>
VIDEO_REPLACER_TOS_BUCKET=<replace-with-private-bucket>
VIDEO_REPLACER_TOS_PREFIX=video-replacer
VIDEO_REPLACER_TOS_LIFECYCLE_RULE_ID=<replace-with-enabled-expiry-rule-id>
