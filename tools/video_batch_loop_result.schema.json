{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "batch_status": {
      "type": "string",
      "enum": [
        "READY_FOR_SUBMISSION",
        "PARTIAL",
        "BLOCKED",
        "FAILED",
        "NO_ELIGIBLE_JOBS"
      ]
    },
    "summary": {
      "type": "string"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^V[0-9]{3}$" },
          "status": {
            "type": "string",
            "enum": ["READY_FOR_SUBMISSION", "BLOCKED", "FAILED", "SKIPPED"]
          },
          "task_id": { "type": "null" },
          "output_path": { "type": "null" },
          "blocker": { "type": ["string", "null"] }
        },
        "required": ["id", "status", "task_id", "output_path", "blocker"]
      }
    }
  },
  "required": ["batch_status", "summary", "jobs"]
}
